# ai-dev-team credentials — single source of truth
# Copy this file to .env and fill in real values. NEVER commit .env.
# chmod 600 ~/ai-dev-team/shared/credentials/.env after editing.
#
# Replace each PUT_*_HERE placeholder with your real key.
# Leave anything you don't use as the placeholder or blank.

# ============================================================
# GitHub (for local github-mcp-server)
# Generate a fine-grained PAT: https://github.com/settings/personal-access-tokens
# Scopes: read repos, PRs, issues, actions (only what you need)
# ============================================================
GITHUB_PERSONAL_ACCESS_TOKEN=PUT_GITHUB_PAT_HERE

# ============================================================
# Market Data
# Get a key: https://polygon.io/dashboard/api-keys (free tier OK to start)
# ============================================================
POLYGON_API_KEY=PUT_POLYGON_API_KEY_HERE

# ============================================================
# Broker (Alpaca — paper-first)
# Get keys: https://app.alpaca.markets/paper/dashboard/overview -> "View API Keys"
# ============================================================
ALPACA_API_KEY=PUT_ALPACA_API_KEY_HERE
ALPACA_SECRET_KEY=PUT_ALPACA_SECRET_KEY_HERE
PAPER=True

# ============================================================
# Operational MCP servers
# REDIS_URL: local default works if Redis runs on this host.
# PAGERDUTY_API_KEY: optional — leave placeholder unless you use PagerDuty.
# ============================================================
REDIS_URL=redis://localhost:6379
PAGERDUTY_API_KEY=PUT_PAGERDUTY_API_KEY_HERE

# ============================================================
# Local model endpoints (no keys needed, but useful to centralize)
# ============================================================
VLLM_ENDPOINT=http://localhost:8000/v1
LMSTUDIO_ENDPOINT=http://localhost:1234/v1
LOCAL_MODEL=Qwen/Qwen2.5-32B-Instruct

# ============================================================
# Optional — cloud fallbacks (leave as placeholder unless you want them)
# ============================================================
ANTHROPIC_API_KEY=PUT_ANTHROPIC_API_KEY_HERE
OPENAI_API_KEY=PUT_OPENAI_API_KEY_HERE
