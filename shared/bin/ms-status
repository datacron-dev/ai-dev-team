#!/usr/bin/env bash
# ms-status — pre-flight check for an ai-dev-team work session
#
# Verifies everything Cline needs is running and healthy:
#   - .env loaded, keys present
#   - vLLM server up and serving
#   - Cline-vLLM bridge registered on a discoverable port
#   - Docker daemon up (for github-mcp-server)
#   - uv and uvx available (for python MCP servers)
#
# Prints a compact status report. Exit code 0 = all good, 1 = something broken.

set -uo pipefail

# Colors
if [[ -t 1 ]]; then
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    RED='\033[0;31m'
    CYAN='\033[0;36m'
    NC='\033[0m'
else
    GREEN='' YELLOW='' RED='' CYAN='' NC=''
fi

FAIL=0

pass() { echo -e " ${GREEN}✓${NC} $*"; }
warn() { echo -e " ${YELLOW}⚠${NC} $*"; }
fail() { echo -e " ${RED}✗${NC} $*"; FAIL=1; }
head() { echo -e "\n${CYAN}==> $*${NC}"; }

# --- 1. Environment ---------------------------------------------------------
head "Environment"

if [[ -f "$HOME/ai-dev-team/shared/credentials/.env" ]]; then
    pass ".env exists at ~/ai-dev-team/shared/credentials/.env"
    PERMS=$(stat -c '%a' "$HOME/ai-dev-team/shared/credentials/.env" 2>/dev/null)
    if [[ "$PERMS" == "600" ]]; then
        pass ".env permissions are 600"
    else
        warn ".env permissions are ${PERMS} (should be 600). Fix: chmod 600 ~/ai-dev-team/shared/credentials/.env"
    fi
else
    fail ".env missing"
fi

# Check individual keys (existence only, never print values)
check_var() {
    local var="$1"
    local required="${2:-required}"
    if [[ -n "${!var:-}" ]]; then
        pass "$var is set (${#var} char name; value hidden)"
    elif [[ "$required" == "optional" ]]; then
        warn "$var is empty (optional)"
    else
        fail "$var is empty"
    fi
}

check_var GITHUB_PERSONAL_ACCESS_TOKEN
check_var POLYGON_API_KEY
check_var ALPACA_API_KEY
check_var ALPACA_SECRET_KEY
check_var PAPER
check_var PAGERDUTY_API_KEY optional
check_var REDIS_URL optional

# --- 2. vLLM / local model server -------------------------------------------
head "Local Model Server"

VLLM_ENDPOINT="${VLLM_ENDPOINT:-http://localhost:8000/v1}"
if curl -sf --max-time 3 "${VLLM_ENDPOINT}/models" >/dev/null 2>&1; then
    MODEL=$(curl -sf --max-time 3 "${VLLM_ENDPOINT}/models" | \
        python3 -c "import sys, json; d=json.load(sys.stdin); print(d['data'][0]['id'])" 2>/dev/null)
    pass "vLLM responding at ${VLLM_ENDPOINT} (model: ${MODEL:-unknown})"
else
    fail "vLLM not responding at ${VLLM_ENDPOINT}"
    echo "     Start it, or set VLLM_ENDPOINT if it's on a different port."
fi

# --- 3. Cline-vLLM Bridge ---------------------------------------------------
head "Cline-vLLM Bridge"

if systemctl --user is-active --quiet cline-vllm-bridge.service 2>/dev/null; then
    pass "cline-vllm-bridge.service is active (user unit)"
elif systemctl is-active --quiet cline-vllm-bridge.service 2>/dev/null; then
    pass "cline-vllm-bridge.service is active (system unit)"
else
    warn "cline-vllm-bridge.service not detected as active. If you use a different service name, ignore this."
fi

# Show which port the bridge advertises (implementation-specific — adapt as needed)
if [[ -f "$HOME/.ai-dev-team/bridge-port" ]]; then
    BRIDGE_PORT=$(cat "$HOME/.ai-dev-team/bridge-port")
    if curl -sf --max-time 2 "http://localhost:${BRIDGE_PORT}/v1/models" >/dev/null 2>&1; then
        pass "Bridge port ${BRIDGE_PORT} responding"
    else
        warn "Bridge port ${BRIDGE_PORT} recorded but not responding"
    fi
else
    warn "No ~/.ai-dev-team/bridge-port file — bridge port discovery may use a different mechanism"
fi

# --- 4. Docker (for github MCP) --------------------------------------------
head "Docker"

if command -v docker >/dev/null 2>&1; then
    if docker info >/dev/null 2>&1; then
        pass "docker daemon reachable"
        if docker image inspect ghcr.io/github/github-mcp-server:latest >/dev/null 2>&1; then
            pass "github-mcp-server image cached"
        else
            warn "github-mcp-server image not pulled. First github MCP call will trigger a ~50MB download."
        fi
    else
        fail "docker installed but daemon unreachable. Try: sudo systemctl start docker"
    fi
else
    fail "docker not installed"
fi

# --- 5. Python MCP toolchain ------------------------------------------------
head "Python MCP Toolchain"

if [[ -x "$HOME/.local/bin/uvx" ]]; then
    UVX_VER=$("$HOME/.local/bin/uvx" --version 2>/dev/null | head -1)
    pass "uvx present: ${UVX_VER}"
else
    fail "uvx not at ~/.local/bin/uvx"
fi

if command -v npx >/dev/null 2>&1; then
    pass "npx present ($(npx --version 2>/dev/null))"
else
    warn "npx not found (needed for kubernetes + playwright MCPs)"
fi

# --- 6. Mothership structure ------------------------------------------------
head "ai-dev-team Structure"

for dir in shared/skills shared/mcp shared/credentials shared/harness projects; do
    if [[ -d "$HOME/ai-dev-team/$dir" ]]; then
        pass "~/ai-dev-team/$dir exists"
    else
        fail "~/ai-dev-team/$dir missing"
    fi
done

SKILL_COUNT=$(find "$HOME/ai-dev-team/shared/skills" -name SKILL.md 2>/dev/null | wc -l)
if [[ "$SKILL_COUNT" -gt 0 ]]; then
    pass "${SKILL_COUNT} skills available"
else
    warn "No skills found in ~/ai-dev-team/shared/skills"
fi

# --- Summary ---------------------------------------------------------------
head "Summary"
if [[ "$FAIL" -eq 0 ]]; then
    echo -e " ${GREEN}All systems green.${NC} Launch VS Code from this shell: ${CYAN}code ~/ai-dev-team/projects/financial-terminal${NC}"
    exit 0
else
    echo -e " ${RED}Some checks failed.${NC} Fix items marked ✗ before starting a session."
    exit 1
fi
